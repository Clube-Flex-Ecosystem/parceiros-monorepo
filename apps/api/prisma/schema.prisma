generator client {
  provider = "prisma-client"
  output   = "../src/database/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum ContactType {
  phone
  whatsapp
}

enum PartnerStatus {
  draft
  published
  inactive
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique @db.VarChar(320)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(120)
  partners  Partner[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Plan {
  id        String                @id @default(cuid())
  name      String                @unique @db.VarChar(120)
  discounts PartnerPlanDiscount[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model Partner {
  id                  String                @id @default(cuid())
  name                String
  description         String
  address             String?
  generalInstructions String?
  website             String?
  slug                String                @unique
  isFeatured          Boolean               @default(false)
  status              PartnerStatus         @default(draft)
  categoryId          String
  category            Category              @relation(fields: [categoryId], references: [id])
  contacts            Contact[]
  discounts           PartnerPlanDiscount[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Contact {
  id        String      @id @default(cuid())
  type      ContactType
  value     String
  label     String?
  partnerId String
  partner   Partner     @relation(fields: [partnerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([partnerId])
}

model PartnerPlanDiscount {
  id              String   @id @default(cuid())
  discountPercent Float
  condition       String?
  coupon          String?
  instructions    String?
  partnerId       String
  planId          String
  partner         Partner  @relation(fields: [partnerId], references: [id])
  plan            Plan     @relation(fields: [planId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([partnerId, planId])
  @@index([partnerId])
  @@index([planId])
}
